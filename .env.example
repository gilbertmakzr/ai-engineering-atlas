# Docker Compose web runtime. It intentionally has no YouTube/API credentials.
ATLAS_HTTP_PORT=3000
ATLAS_IMAGE_TAG=local
# Host directory containing only state/audit/projection, never a secret.
ATLAS_STATE_DIR=./var/atlas-state

# Public Lovable/custom deployment URL used for canonical, social and sitemap metadata.
VITE_SITE_URL=https://ai-engineer-atlas.lovable.app

# Discovery is disabled by default. Do not put YOUTUBE_DATA_API_KEY in this file.
# The daily Atlas job uses the YouTube Data API uploads playlist in bounded,
# paced batches. Put the key in the local operator secret store, enable this
# flag in a mode-600 operator configuration file, and pin the playlist ID.
YOUTUBE_DISCOVERY_ENABLED=0
ATLAS_DISCOVERY_SCHEDULE_ENABLED=false
# Publish only title, channel, date and duration for newly reconciled uploads.
# These records have no transcript-derived claims and remain unmapped for insights.
ATLAS_METADATA_AUTO_PUBLISH_ENABLED=false
# A daily command refuses to run without both flags, an API key and this pinned
# uploads-playlist ID. This repository supplies no scheduler or host job.
# YOUTUBE_DATA_API_KEY= (secret-manager or mode-600 operator config only)
YOUTUBE_DISCOVERY_UPLOADS_PLAYLIST_ID=
# The newest-upload check uses one 10-item page. The reconciliation cursor checks
# one additional 50-item page per day, eventually covering every official upload.
# An operator can use YOUTUBE_DISCOVERY_RECONCILE_FULL=true for a paced full audit.
YOUTUBE_DISCOVERY_PACE_MS=250
YOUTUBE_DAILY_RECONCILIATION_PAGES=1
# YOUTUBE_DISCOVERY_RECONCILE_FULL=true

# Lovable/Supabase integration. Keep server-only values out of VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for trusted server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Hosted semantic retrieval. Store PINECONE_API_KEY only in the deployment secret manager,
# never in a VITE_ variable or a committed .env file. Enable after a completed index sync.
PINECONE_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=approved-insights-v1
PINECONE_CATALOG_CONTENT_HASH=
